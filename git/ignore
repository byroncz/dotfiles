# gitignore GLOBAL del usuario.
#
# Aplica a TODOS los repositorios del container, no a uno concreto. Para
# reglas de un proyecto usa el .gitignore de ese repositorio, que viaja con
# él y también le sirve a quien lo clone.
#
# Aquí va solo lo que es ruido en CUALQUIER repo: basura del sistema
# operativo, del editor, y archivos que nunca deben subirse a ningún sitio.
#
# Se edita como un archivo normal y se commitea. No hay que reconstruir la
# imagen: el container lo lee desde ~/.dotfiles.

# ── Sistema operativo ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editores ───────────────────────────────────────────────────────────────
*.swp
*.swo
*~

# ── Secretos ───────────────────────────────────────────────────────────────
# Red de seguridad, no la única defensa: lo que de verdad evita el accidente
# es no escribir secretos dentro del repo.
.env
.env.*
!.env.example

# ── Ruido de herramientas ──────────────────────────────────────────────────
.ipynb_checkpoints/

# Configuración local de agentes: es de esta máquina, no del proyecto.
.claude/settings.local.json

# Configuración de MCP GENERADA por el devcontainer desde
# .devcontainer/mcp/servers.json. Aquí y no en el .gitignore de cada
# proyecto: el repo donde aterriza suele ser el del cliente, que no tiene por
# qué cargar con una regla para un artefacto de nuestro template. Editarlos a
# mano no sirve de nada, se regeneran en el siguiente arranque.
.mcp.json
