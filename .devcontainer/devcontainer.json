{
  "name": "gt-algorithia-capta-homologacion",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": [
    "--name",
    "gt-algorithia-capta-homologacion"
  ],
  "remoteUser": "devuser",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=capta-claude-config,target=/home/devuser/.claude,type=volume",
    "source=capta-ide-extensions,target=/home/devuser/.antigravity-ide-server/extensions,type=volume"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "amazonwebservices.aws-toolkit-vscode",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "/workspace",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    }
  },
  "postCreateCommand": "aws --version && python -c \"import nbformat; print('nbformat OK')\" && python -c \"import boto3; print('boto3 OK')\" && chmod +x .devcontainer/*.sh 2>/dev/null ; bash .devcontainer/install-extensions.sh ; true"
}