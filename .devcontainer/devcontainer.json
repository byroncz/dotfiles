{
  // ───────────────────────────────────────────────────────────────────────
  //  Template de devcontainer sobre Docker Compose. Copiar como
  //  .devcontainer/ dentro de un proyecto. Lo que suele cambiar NO está
  //  aquí, sino en .devcontainer/.env y en docker-compose.yml.
  //  Ver README.md.
  //
  //  Este archivo ya NO describe la imagen: solo apunta al compose. Los
  //  volúmenes, las variables de entorno y los puertos viven allí.
  // ───────────────────────────────────────────────────────────────────────
  "name": "${localWorkspaceFolderBasename}",

  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",

  // Debe coincidir EXACTAMENTE con el destino del bind de código en el
  // compose ("..:/workspace"). Ruta fija en singular: no depende del nombre
  // del directorio local, que puede llevar espacios o mayúsculas (Problema 9b).
  "workspaceFolder": "/workspace",

  // Debe coincidir con el arg USERNAME del compose (por defecto "vscode").
  // devcontainer.json no lee .env, así que si cambias uno, cambia el otro.
  "remoteUser": "vscode",

  // ───────────────────────────────────────────────────────────────────────
  //  OBLIGATORIO: "none".
  //
  //  El valor por defecto ("stopCompose") pararía TODOS los servicios del
  //  compose al cerrar el devcontainer, incluidos los sidecars de respaldo,
  //  que es justo cuando más falta hacen. No cambiar.
  // ───────────────────────────────────────────────────────────────────────
  "shutdownAction": "none",

  "customizations": {
    "vscode": {
      // Antigravity ignora este campo (Problema 3): la instalación real la
      // hace install-extensions.sh. Se mantiene por documentación y para
      // otros IDEs.
      "extensions": ["anthropic.claude-code"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash", "args": ["-l"] }
        }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
