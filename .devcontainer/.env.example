# ───────────────────────────────────────────────────────────────────────────
#  Copiar a .devcontainer/.env y ajustar. Ese archivo NO se versiona.
#
#  AQUÍ NO VAN SECRETOS. Solo identificadores y parámetros de build.
#  La contraseña del rclone.conf se inyecta desde un .env FUERA del repo
#  (ver CONFIGURACION-MANUAL.md).
# ───────────────────────────────────────────────────────────────────────────

# Identifican al cliente y al proyecto. Determinan el nombre del contenedor
# y, sobre todo, el nombre de los volúmenes: claude-<CLIENTE> se comparte
# entre los proyectos de un mismo cliente y NUNCA entre clientes distintos.
CLIENTE=local
PROYECTO=dev

# ── Build args (todos opcionales) ──────────────────────────────────────────
# Cualquier imagen basada en Debian/Ubuntu con apt-get.
BASE_IMAGE=debian:bookworm-slim
USERNAME=vscode
# Paquetes apt adicionales, separados por espacios.
EXTRA_APT=
# Requiere una BASE_IMAGE que traiga pip.
PIP_PACKAGES=
INSTALL_AWSCLI=false
