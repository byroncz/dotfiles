# ───────────────────────────────────────────────────────────────────────────
#  Copiar a .devcontainer/.env y ajustar. Ese archivo NO se versiona.
#
#  AQUÍ NO VAN SECRETOS. Solo identificadores y parámetros de build.
#  La contraseña del rclone.conf se inyecta desde un .env FUERA del repo
#  (ver docs/CONFIGURACION-MANUAL.md).
# ───────────────────────────────────────────────────────────────────────────

# Identifican al cliente y al proyecto. Determinan el nombre del contenedor
# y, sobre todo, el nombre de los volúmenes: claude-<CLIENTE> se comparte
# entre los proyectos de un mismo cliente y NUNCA entre clientes distintos.
CLIENTE=local
PROYECTO=dev

# ── Build args (todos opcionales) ──────────────────────────────────────────
# Cualquier imagen basada en Debian/Ubuntu con apt-get.
BASE_IMAGE=debian:trixie-slim
USERNAME=vscode
# Paquetes apt adicionales, separados por espacios.
EXTRA_APT=
# Requiere una BASE_IMAGE que traiga pip.
PIP_PACKAGES=
INSTALL_AWSCLI=false

# ── Neovim ─────────────────────────────────────────────────────────────────
# Instala Neovim (tarball oficial), ripgrep, fd, tmux y build-essential.
# Añade unos 300 MB a la imagen; ponlo a false si el proyecto no lo necesita.
INSTALL_NVIM=true

# Iconos de LazyVim (árbol de archivos, signos de git, statusline). Requieren
# una Nerd Font instalada Y configurada en la terminal desde la que abras el
# container; si falta, verás cuadraditos. La funcionalidad —LSP, diagnósticos,
# búsqueda— es idéntica en los dos casos: esto es solo estético.
#   brew install --cask font-jetbrains-mono-nerd-font
NERD_FONT=false

# ── Dotfiles ───────────────────────────────────────────────────────────────
# Repo con tu configuración de usuario (gitignore global, config de git y,
# más adelante, nvim). Se clona en ~/.dotfiles DENTRO del container, nunca
# dentro del repo del proyecto.
#
# Si lo dejas vacío, el container arranca con la config de git por defecto.
# Si el repo es privado, el clone fallará salvo que el container tenga
# credenciales; en ese caso usa la URL SSH y monta tu agente, o hazlo público.
DOTFILES_REPO=https://github.com/byroncz/dotfiles.git

# ── Respaldo cifrado ───────────────────────────────────────────────────────
# Los sidecars de respaldo NO arrancan hasta que descomentes esta línea.
# Hazlo solo después de completar docs/CONFIGURACION-MANUAL.md: sin el remoto
# creado, se reiniciarían en bucle.
# COMPOSE_PROFILES=respaldo

# El nombre del remoto cifrado NO se configura aquí: se deriva de CLIENTE.
# Los sidecars esperan UN remoto, creado en el paso 2 del manual:
#
#   crypt-<CLIENTE>   ->   dropbox:backups/devcontainers/<CLIENTE>
#
# Uno por cliente, con sus propias claves. Se configura UNA vez por cliente:
# los volúmenes cuelgan de él como subrutas (claude/, knowledge/,
# <PROYECTO>/workspace/, <PROYECTO>/historial/), así que añadir un volumen
# nuevo o un proyecto nuevo no requiere tocar rclone.
#
# CLIENTE y PROYECTO deben ser identificadores simples, sin espacios ni
# acentos: acaban siendo nombres de remoto y rutas de carpeta.

# La contraseña del rclone.conf NO va aquí. Va en un archivo fuera del
# repositorio, ~/.config/rclone/devcontainer.env, que los sidecars leen
# por env_file. Ver el paso 5 del manual.
