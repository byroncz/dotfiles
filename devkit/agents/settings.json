{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(git push origin feat/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(gh pr:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh pr review --comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(ruff:*)",
      "Bash(basedpyright:*)",
      "Bash(pytest:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(devkit-net-denied:*)",
      "Bash(touch /run/devkit/poke)",
      "mcp__plugin_Notion_notion",
      "mcp__plugin_Notion_notion__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git branch -D main:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr merge --squash:*)",
      "Bash(gh pr merge --merge:*)",
      "Bash(gh pr merge --rebase:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh pr review -a:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(cat /run/devkit:*)",
      "Read(/run/devkit/**)",
      "Read(/run/secrets/**)",
      "Read(~/.config/rclone/**)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
