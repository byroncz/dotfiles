# devkit: variables del proyecto. Entran al contenedor de trabajo.
# Copiar como ~/.devkit/<proyecto>/devkit.env y completar.

# Nombre corto del proyecto (contenedor, hostname, directorio en ~/.devkit).
# El código de Notion vive en devkit.toml, dentro del repo.
DEVKIT_PROJECT=devkit

# Repo del proyecto. Se clona en /workspace al primer arranque.
DEVKIT_REPO=https://github.com/byroncz/dotfiles.git

# Identidad git dentro del contenedor (la cuenta máquina para los agentes).
GIT_USER_NAME=byroncz-bot
GIT_USER_EMAIL=bot@example.com

# Respaldo del sandbox en Dropbox. Requiere el secreto rclone_conf en Bitwarden.
DEVKIT_SANDBOX_REMOTE=dropbox:devkit/sandbox.local
